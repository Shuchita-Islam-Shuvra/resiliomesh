APP_ENV=development
# Supabase > Project Settings > API
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Only needed for scripts/seed_demo.py (NEVER expose to the frontend)
SUPABASE_SERVICE_ROLE_KEY=
# Only if your project still uses the legacy HS256 JWT secret (new projects use JWKS automatically)
SUPABASE_JWT_SECRET=
# Supabase > Connect > Session pooler (IPv4-friendly). URL-encode special characters in the password.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-DB-PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
CORS_ORIGINS=http://localhost:5173,https://resiliomesh.vercel.app
WORKER_IN_PROCESS=true
RATE_LIMIT_PER_MINUTE=120
WEATHER_TIMEOUT_S=4
WEATHER_MAX_RETRIES=3
# Judge demo sign-in (one click per demo profile). Off unless all three are set. Never commit real values.
DEMO_MODE=false
DEMO_PASSWORD=
# optional: leave empty and the demo profiles open with one click, no code
DEMO_ACCESS_CODE=
# public anon key (the website's VITE_SUPABASE_ANON_KEY also works)
SUPABASE_ANON_KEY=
