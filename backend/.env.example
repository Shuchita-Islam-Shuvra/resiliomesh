APP_ENV=development
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-DB-PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
CORS_ORIGINS=http://localhost:5173,https://resiliomesh.vercel.app
WORKER_IN_PROCESS=true
RATE_LIMIT_PER_MINUTE=120
WEATHER_TIMEOUT_S=4
WEATHER_MAX_RETRIES=3
DEMO_MODE=false
DEMO_PASSWORD=
DEMO_ACCESS_CODE=
SUPABASE_ANON_KEY=
# Notifications: e-mail / SMS copies (default "log" = not sent, marked skipped). See docs/API_SETUP.md
APP_PUBLIC_URL=https://resiliomesh.vercel.app
NOTIFY_EMAIL_PROVIDER=log
NOTIFY_EMAIL_FROM=ResilioMesh <alerts@resiliomesh.app>
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFY_SMS_PROVIDER=log
BULKSMSBD_API_KEY=
BULKSMSBD_SENDER_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
